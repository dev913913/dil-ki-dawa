# Set these in Vercel -> Project -> Settings -> Environment Variables.
# At least one AI key is required.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional but recommended: makes video lookup reliable (YouTube Data API v3).
YOUTUBE_API_KEY=

# Optional overrides (comma-separated Gemini models, tried in order).
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# GROQ_MODEL=llama-3.1-8b-instant
